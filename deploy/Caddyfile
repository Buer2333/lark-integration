# video-gen web app (phase-2). Source of truth: lark-integration deploy/Caddyfile.
# 443 belongs to xray (proxy node) — Caddy owns 80 (ACME HTTP-01 + redirect)
# and 8443 (TLS). Rollback: systemctl stop caddy (bot unaffected).
{
	http_port 80
	https_port 8443
}

# explicit :80 redirect (Caddy 2.6 auto-redirect omits the custom https_port)
http://video.hiileathy.com {
	redir https://video.hiileathy.com:8443{uri} permanent
}

video.hiileathy.com {
	request_body {
		max_size 80MB
	}
	# Public read-only video staging for Instagram Graph API pulls
	# (jobs/brand_social publisher; dirs are random 16-hex, removed after
	# writeback_done). Meta must fetch video_url over HTTPS: this host's
	# https_port is 8443 (443 = xray, never bind). Source dir owned by shining.
	handle_path /ig/* {
		root * /home/shining/services/lark-bot/data/public/ig
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8899
	}
}
