[Unit]
Description=Editor Audit Report (GMV Max creative_delivery_status per item)
After=network-online.target
Wants=network-online.target

# 失败即推 Shining Inbox（含 OOM SIGKILL —— Python 侧的 run_with_error_fallback 收不到那条路径）
OnFailure=unit-failure-alert@%n.service

[Service]
Type=oneshot
User=shining
WorkingDirectory=/home/shining/services/lark-bot
# 窗口护栏（2026-08-07 事故加固）：排程 01:30 UTC；[01:00,06:00) UTC 外拒跑。
ExecStart=/bin/bash -c 'H=$(date -u +%%H); if [ "$H" -lt 1 ] || [ "$H" -ge 6 ]; then echo "[guard] outside 01-06 UTC window, refusing (anti mis-fire)"; exit 0; fi; exec /home/shining/services/lark-bot/.venv/bin/python run.py editor_audit_report --today'
EnvironmentFile=/home/shining/services/lark-bot/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=editor-audit-report
# 2026-09-20 T-20260919-007 按实测重定：修复后冷跑峰值 未测·同路径按 morning-briefing 取（memory.current，anon 为主）。
# MemoryHigh=软限（超过即回收/节流，不杀）≈实测×1.5～1.8；MemoryMax=硬顶≈实测×2.2～2.5。
# 之前 150M 是 e2-micro(1GB)+有 swap 时代定的，禁 swap 后 anon 超限即 SIGKILL。
MemoryHigh=300M
MemoryMax=450M
# 禁 swap（2026-09-19 整机僵死加固，原为手工 drop-in 50-noswap.conf；收编进 git 消灭 drift）。
# 禁了 swap 之后 MemoryMax 必须按「无 swap 也够用」定：见 2026-09-20 T-20260919-007 实测。
MemorySwapMax=0
NoNewPrivileges=true
