[Unit]
Description=Team Lead Daily Report (private message to leads)
After=network-online.target
Wants=network-online.target

# 失败即推 Shining Inbox（含 OOM SIGKILL —— Python 侧的 run_with_error_fallback 收不到那条路径）
OnFailure=unit-failure-alert@%n.service

[Service]
Type=oneshot
User=shining
WorkingDirectory=/home/shining/services/lark-bot
# 窗口护栏（2026-08-07 事故加固）：排程 10:20 UTC；[10:00,14:00) UTC 外拒跑
# ——该窗口内 ET "yesterday" 才等于正确的 T-1。带参手动补推走引擎直调不受影响。
ExecStart=/bin/bash -c "H=$(date -u +%%H); if [ \"$H\" -lt 10 ] || [ \"$H\" -ge 14 ]; then echo '[guard] outside 10-14 UTC window, refusing (anti mis-fire)'; exit 0; fi; YESTERDAY=$(TZ=America/New_York date -d yesterday +%%Y-%%m-%%d) && exec .venv/bin/python run.py daily_report --view lead --date $YESTERDAY --push-to-leads"
# 组长卡 v2 并行预览（用户 2026-10-07，7 天）：旧组长卡不变；`-` 前缀 = 失败不让旧 job 记失败。
# (a) attribution_prime 自带开关（ATTRIBUTION_V2_ENTRIES 不含 prime 时只打日志退出）；
# (b) team_lead_v2_preview 只读缓存、只推 Shining Inbox，不私聊组长。窗口护栏同 ExecStart。
ExecStartPost=-/bin/bash -c 'H=$(date -u +%%H); if [ "$H" -lt 10 ] || [ "$H" -ge 14 ]; then echo "[guard] attribution_prime skipped outside 10-14 UTC window"; exit 0; fi; YESTERDAY=$(TZ=America/New_York date -d yesterday +%%Y-%%m-%%d) && exec .venv/bin/python run.py attribution_prime --date $YESTERDAY'
ExecStartPost=-/bin/bash -c 'H=$(date -u +%%H); if [ "$H" -lt 10 ] || [ "$H" -ge 14 ]; then echo "[guard] team_lead_v2_preview skipped outside 10-14 UTC window"; exit 0; fi; YESTERDAY=$(TZ=America/New_York date -d yesterday +%%Y-%%m-%%d) && exec .venv/bin/python run.py team_lead_v2_preview --date $YESTERDAY --push-chat-id oc_66ec50a46020044446d67d1259e6308f'
EnvironmentFile=/home/shining/services/lark-bot/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=team-lead-report
# 2026-09-20 T-20260919-007 按实测重定：修复后冷跑峰值 296M（memory.current；anon 268M）——
# 修复前同一天实测 726M/633M，09-17/18 journal 里 300M peak + 296~367M swap peak 与之吻合。
# MemoryHigh=软限（超过即回收/节流）；MemoryMax=硬顶。10:20 与 material-report(10:00 链)、
# gmvmax-monitor(10:15) 有重叠：三者实测峰值之和 643M + 常驻最坏 ~1.1G < 2G。
# 之前 300M 是 e2-micro(1GB)+有 swap 时代定的。
# ExecStartPost 与 ExecStart 同一 cgroup、串行执行（峰值不叠加）：preview 只读缓存；
# prime 在 ATTRIBUTION_V2_ENTRIES 含 prime 后才取数，GMVMAX roster 载荷若未被前序命中会冷拉
# （attribution_detail，历史冷跑峰值见下），开 prime 前先看一次 journal 的 memory peak。
MemoryHigh=450M
MemoryMax=600M
# 禁 swap（2026-09-19 整机僵死加固，原为手工 drop-in 50-noswap.conf；收编进 git 消灭 drift）。
# 禁了 swap 之后 MemoryMax 必须按「无 swap 也够用」定：见 2026-09-20 T-20260919-007 实测。
MemorySwapMax=0
NoNewPrivileges=true
