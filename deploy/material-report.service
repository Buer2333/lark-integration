[Unit]
Description=Daily Material Report (all product groups)
After=network-online.target
Wants=network-online.target

# 失败即推 Shining Inbox（含 OOM SIGKILL —— Python 侧的 run_with_error_fallback 收不到那条路径）
OnFailure=unit-failure-alert@%n.service

[Service]
Type=oneshot
User=shining
WorkingDirectory=/home/shining/services/lark-bot
# 窗口护栏（2026-08-07 事故，机器强制）：排程 10:00 UTC；只允许 [10:00,14:00) UTC
# 内执行，窗口外（Persistent 补跑残留/误触 systemctl start/错时手动）直接拒跑
# exit 0——因为 ET "yesterday" 只在此窗口内等于正确的 T-1，窗口外会推错日期。
# 带参数的手动补推不受影响（那走 run.py 直调，不经本 unit）。
# 2026-09-17 组长→组员维度：末尾 material_dispatch --by-lead 按组织架构表逐组长出跨产品线
# 小组卡，路由走 chat_routing.json 的 lead:<组长> 键（缺键只告警不回落）；原
# FlyNew-US-Shilajit --team 汪宇航 一行删除（该组旧卡口径错误，用户 2026-09-17 决定停发）。
# 用 ; 而非 && 接在最后：公共车道卡任一失败不应连带跳过小组卡。MemoryMax 200M→320M
# （by-lead 一次拉全车道明细，参考 script-library-sync 212M 峰值）。
ExecStart=/bin/bash -c '\
  H=$(date -u +%%H) && \
  if [ "$H" -lt 10 ] || [ "$H" -ge 14 ]; then \
    echo "[guard] refusing to run outside 10:00-14:00 UTC window (now ${H}:xx UTC) — anti mis-fire, see 2026-08-07 incident"; \
    exit 0; \
  fi && \
  YESTERDAY=$(TZ=America/New_York date -d "yesterday" +%%Y-%%m-%%d) && \
  .venv/bin/python run.py material_report \
    --product-group Hiileathy-US-NAD+ \
    --start-date "$YESTERDAY" --end-date "$YESTERDAY" \
    --push-chat-id oc_d7e61968e4a6d9989b4354bc14861e12 && \
  .venv/bin/python run.py material_report \
    --product-group Hiileathy-US-Shilajit \
    --start-date "$YESTERDAY" --end-date "$YESTERDAY" \
    --push-chat-id oc_ab30ead006c140725a1ee0e8fd98e6d4 && \
  .venv/bin/python run.py material_report \
    --product-group FlyNew-US-Shilajit --team 杨斯丹 \
    --start-date "$YESTERDAY" --end-date "$YESTERDAY" \
    --push-chat-id oc_3a8c367358d0ae61ba9fa26f52ba2f86 && \
  .venv/bin/python run.py material_report \
    --product-group FlyNew-US-Bundle \
    --start-date "$YESTERDAY" --end-date "$YESTERDAY" \
    --push-chat-id oc_20ccb01affd50aade9ff16a0e714f8d8 && \
  .venv/bin/python run.py material_report \
    --product-group Hiileathy-US-NMN \
    --start-date "$YESTERDAY" --end-date "$YESTERDAY" ; \
  .venv/bin/python run.py material_dispatch --by-lead --date "$YESTERDAY"'
EnvironmentFile=/home/shining/services/lark-bot/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=material-report
# 2026-09-20 T-20260919-007 按实测重定：修复后冷跑峰值 206M（memory.current，anon 为主）。
# MemoryHigh=软限（超过即回收/节流，不杀）≈实测×1.5～1.8；MemoryMax=硬顶≈实测×2.2～2.5。
# 之前 320M 是 e2-micro(1GB)+有 swap 时代定的，禁 swap 后 anon 超限即 SIGKILL。
MemoryHigh=350M
MemoryMax=500M
# 禁 swap（2026-09-19 整机僵死加固，原为手工 drop-in 50-noswap.conf；收编进 git 消灭 drift）。
# 禁了 swap 之后 MemoryMax 必须按「无 swap 也够用」定：见 2026-09-20 T-20260919-007 实测。
MemorySwapMax=0
NoNewPrivileges=true
