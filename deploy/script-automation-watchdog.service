[Unit]
Description=Script automation watchdog (脚本生产台 Base automation 静默检测)
After=network-online.target
Wants=network-online.target

# 失败即推 Shining Inbox（含 OOM SIGKILL —— Python 侧的 run_with_error_fallback 收不到那条路径）
OnFailure=unit-failure-alert@%n.service

[Service]
Type=oneshot
User=shining
WorkingDirectory=/home/shining/services/lark-bot
# 窗口护栏（同 script-todo-digest / editor-audit-report）：排程北京 09:05-21:05
# （UTC 01:05-13:05，每小时一次）；[01:00,14:00) UTC 外拒跑，防 unit 下发/重启误触发。
ExecStart=/bin/bash -c 'H=$(date -u +%%H); if [ "$H" -lt 1 ] || [ "$H" -ge 14 ]; then echo "[guard] outside 01-14 UTC window, refusing (anti mis-fire)"; exit 0; fi; exec /home/shining/services/lark-bot/.venv/bin/python run.py script_automation_watchdog --apply'
EnvironmentFile=/home/shining/services/lark-bot/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=script-automation-watchdog
# 瞬时态抑制两次读表间默认 sleep 120s（run.py 默认 --interval，未在此覆盖）+
# bootstrap（~30s bitable 加载）+ 两次读表——systemd 默认 TimeoutStartSec=90s
# 会在 sleep 中途杀掉进程，必须显式放宽。
TimeoutStartSec=300
# 只读检测：两次读一张 ~150 行的表 + 最多发一条 Inbox 卡；限额沿用 script-todo-digest
# （同一 bootstrap 路径，量级相当）。
MemoryHigh=300M
MemoryMax=450M
MemorySwapMax=0
NoNewPrivileges=true
