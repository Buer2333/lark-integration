[Unit]
Description=Morning Briefing (Top GMVMAX creatives per group)
After=network-online.target
Wants=network-online.target

# 失败即推 Shining Inbox（含 OOM SIGKILL —— Python 侧的 run_with_error_fallback 收不到那条路径）
OnFailure=unit-failure-alert@%n.service

[Service]
Type=oneshot
User=shining
WorkingDirectory=/home/shining/services/lark-bot
# 窗口护栏（2026-08-07 事故加固）：排程 01:00 UTC；[01:00,05:00) UTC 外拒跑。
# 小组早报 v2 正式（Phase 4，用户 2026-10-14 定提前切换，T-20261002-002）：--by-lead --live
# 只发组长卡，按 chat_routing.json 的 lead:<组长> 严格路由（缺键告警不回落），不再跑旧产品线循环。
# 退回并行（旧卡发群 + v2 进 Inbox）= ExecStart 的 job 参数改回
#   morning_briefing --today --lead-shadow-chat-id oc_66ec50a46020044446d67d1259e6308f
# 回滚表见 lark-bot docs/team-lead-report-v2.md「小组早报 v2」。
ExecStart=/bin/bash -c 'H=$(date -u +%%H); if [ "$H" -lt 1 ] || [ "$H" -ge 5 ]; then echo "[guard] outside 01-05 UTC window, refusing (anti mis-fire)"; exit 0; fi; exec /home/shining/services/lark-bot/.venv/bin/python run.py morning_briefing --today --by-lead --live'
EnvironmentFile=/home/shining/services/lark-bot/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=morning-briefing
# 2026-09-20 T-20260919-007 按实测重定：修复后冷跑峰值 201M（memory.current，anon 为主）。
# MemoryHigh=软限（超过即回收/节流，不杀）≈实测×1.5～1.8；MemoryMax=硬顶≈实测×2.2～2.5。
# 之前 150M 是 e2-micro(1GB)+有 swap 时代定的，禁 swap 后 anon 超限即 SIGKILL。
MemoryHigh=300M
MemoryMax=450M
# 禁 swap（2026-09-19 整机僵死加固，原为手工 drop-in 50-noswap.conf；收编进 git 消灭 drift）。
# 禁了 swap 之后 MemoryMax 必须按「无 swap 也够用」定：见 2026-09-20 T-20260919-007 实测。
MemorySwapMax=0
NoNewPrivileges=true
