[Unit]
Description=H3 ComfyUI SSH tunnel (VPS -> gpuhome ah01 127.0.0.1:8188)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shining
ExecStart=/usr/bin/ssh -N -L 127.0.0.1:8188:127.0.0.1:8188 -i /home/shining/.ssh/h3_tunnel_ed25519 -p 30194 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new root@ah01-ssh.gpuhome.cc
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=10
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=h3-tunnel

[Install]
WantedBy=multi-user.target
